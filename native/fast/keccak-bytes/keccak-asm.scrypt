  static function digestOneBlock(bytes input) : bytes {
    int size=len(input);
    require(size<=135);
    bytes padded=b'';
    if(size==135){padded=input+b'81';}else{padded=input+b'01'+num2bin(0,134-size)+b'80';}
    bytes[25] a=repeat(KeccakAsm.ZERO,25);
    loop(17): i { a[i]=KeccakAsm.reverse8(padded[i*8:(i+1)*8]); }
    bytes[25] pstate=KeccakAsm.permute(a);
    a=pstate;
    return KeccakAsm.reverse8(a[0])+KeccakAsm.reverse8(a[1])+KeccakAsm.reverse8(a[2])+KeccakAsm.reverse8(a[3]);
  }
  static function digest(bytes input) : bytes {
    int size = len(input);
    require(size <= 271);
    int paddedSize = size < 136 ? 136 : 272;
    bytes padded = b'';
    if (size == paddedSize-1) { padded = input+b'81'; }
    else { padded = input+b'01'+num2bin(0,paddedSize-size-2)+b'80'; }
    bytes[25] a=repeat(KeccakAsm.ZERO,25);
    loop(2): block {
      if(block*136 < paddedSize) {
        loop(17): i {
          int pos=block*136+i*8;
          a[i] = a[i] ^ KeccakAsm.reverse8(padded[pos:pos+8]);
        }
        bytes[25] pstate=KeccakAsm.permute(a);
    a=pstate;
      }
    }
    return KeccakAsm.reverse8(a[0])+KeccakAsm.reverse8(a[1])+KeccakAsm.reverse8(a[2])+KeccakAsm.reverse8(a[3]);
  }
}
contract KeccakAsmTest {
  bytes expected;
  public function unlock(bytes input) { require(KeccakAsm.digest(input) == this.expected); }
}
