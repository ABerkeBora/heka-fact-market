    "operation": "latestFeeds",
    "nameParameter": {
      "description": "Feed name(s) to query. Can be omitted to return all supported feeds or can be a comma-separated list of feeds. Quote currency is always USD for feeds other than liquid staking exchange rates. Other quotes can be composed by requesting both assets' USD feeds in one call and dividing the first by the second. Never assume a currency has a USD feed. Omitting the 'name' parameter is the best practice to see all supported BASE/QUOTE or exchange rate pairs. Liquid staking exchange-rate feeds are named 'BASE/QUOTE Exchange Rate'. A name Nodary does not serve is absent from the answer rather than an error.",
      "type": "string",
      "examples": [
        "BTC/USD",
        "ETH/USD",
        "wstETH/stETH Exchange Rate"
      ]
    },
    "attestation": {
      "scheme": "eip191-secp256k1",
      "digest": "keccak256(abi.encodePacked(bytes32 requestHash, uint256 timestamp, bytes dataBytes))",
      "dataBytes": "UTF-8 of data",
      "requestHash": "keccak256(utf8(JSON.stringify([operation, parameterEntriesSortedByName]))), where an object value is itself entries sorted by name, at any depth, and an array keeps its order. Names are compared by Unicode code point. A request that carries a projection appends its entries, sorted the same way, as a third element",
      "verify": "Recover the signer of the signature over the digest and check it equals the address above."
    }
  },
