        bit /= 2;
      }
    int zz = JacobianECDSA.mod(acc.z * acc.z);
    return acc.z != 0 && (acc.x == JacobianECDSA.mod(sig.r * zz) || (sig.r + 115792089237316195423570985008687907852837564279074904382605163141518161494337 < 115792089237316195423570985008687907853269984665640564039457584007908834671663 && acc.x == JacobianECDSA.mod((sig.r + 115792089237316195423570985008687907852837564279074904382605163141518161494337) * zz)));
