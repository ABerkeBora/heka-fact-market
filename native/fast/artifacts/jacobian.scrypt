contract AirnodeJacobian {
  bytes requestHash;
  Affine publicKey;
  int validFrom;
  int validTo;
  public function unlock(int timestamp, bytes data, ScalarSignature sig, int sInverse, int jointLambda) {
    require(timestamp >= this.validFrom && timestamp <= this.validTo);
    bytes inner = KeccakOneBlock.digest(this.requestHash + reverseBytes(Utils.toLEUnsigned(timestamp, 32), 32) + data);
    bytes digest = KeccakOneBlock.digest(b'19457468657265756d205369676e6564204d6573736167653a0a3332' + inner);
    require(JacobianECDSA.verify(Utils.fromLEUnsigned(reverseBytes(digest, 32)), sig, this.publicKey, sInverse, jointLambda));
  }
}